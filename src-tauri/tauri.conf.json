{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "KiranaOS POS",
    "version": "0.1.0",
    "identifier": "in.kiranaos.desktop",
    "build": {
        "beforeDevCommand": "npm run dev:web",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build:web",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'"
        }
    },
    "bundle": {
        "active": false,
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
    }
}
